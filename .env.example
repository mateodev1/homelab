PORT=8080
DB_PATH=./data/homelab.db
ENV=development

# M2M client credential (CLI / skills/homelab-api-client). Required when
# ENV=production; ignored otherwise — in non-production only Auth0 JWTs are
# accepted (see AUTH0_DOMAIN/AUTH0_AUDIENCE below). Clients send it as
# `Authorization: Bearer <API_KEY>`.
API_KEY=

# Auth0 — https://manage.auth0.com
# App type: Single Page Application
# Callback / Logout / Web Origins: http://localhost:5173
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Must match AUTH0_AUDIENCE below exactly (same Auth0 API identifier).
# Without it, the frontend can't obtain an API-scoped access token.
VITE_AUTH0_AUDIENCE=https://your-api-identifier

# Backend JWT validation. ALWAYS required (dev and prod) — the backend
# fails to start without these. Must match an API registered in the Auth0
# tenant (Applications > APIs), with its Identifier as AUTH0_AUDIENCE.
# JWKS is fetched from https://${AUTH0_DOMAIN}/.well-known/jwks.json.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
