PORT=8080
DB_PATH=./data/homelab.db
ENV=development

# Required when ENV=production. Clients must send it as
# `Authorization: Bearer <API_KEY>`. Not enforced in development.
API_KEY=

# Auth0 — https://manage.auth0.com
# App type: Single Page Application
# Callback / Logout / Web Origins: http://localhost:5173
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here
