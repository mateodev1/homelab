# Auth0 — crear app en https://manage.auth0.com
# Tipo de app: Single Page Application
# Allowed Callback URLs:  http://localhost:5173
# Allowed Logout URLs:    http://localhost:5173
# Allowed Web Origins:    http://localhost:5173
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here

# Must match the backend's AUTH0_AUDIENCE exactly (same Auth0 API identifier,
# from Applications > APIs in the Auth0 dashboard). Without it,
# getAccessTokenSilently() won't return an API-scoped token and the backend
# will reject it.
VITE_AUTH0_AUDIENCE=https://your-api-identifier
